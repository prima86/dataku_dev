Route::get('coming-soon', function () {
    return view('errors.coming_soon');
});

Auth::routes();

Route::get('/home', 'HomeController@index')->name('home');
Route::get('remove_cookie/{cookie_name}', function ($cookie_name) {
	return Cookie::queue(Cookie::forget($cookie_name));
});

Route::group(['prefix' => 'user'], function () {
	// Route::get('/', 'UserController@dashboard');
  Route::middleware(['CheckPrivilege'])->group(function () {
    Route::get('input', 'UserController@input');
    Route::post('ajax_input_store', 'UserController@ajaxInputStore');
    Route::get('list', 'UserController@list');
    Route::get('edit/{id}', 'UserController@edit');
    Route::get('delete/{id}','UserController@delete');
  });
  Route::post('ajax_upload_avatar', 'UserController@ajaxUploadAvatar');
  Route::post('ajax_update_user', 'UserController@ajaxUpdateUser');
	Route::get('edit_profile', 'UserController@editProfile');
});

Route::group(['prefix' => 'dss'], function () {
	Route::get('/', 'StatistikSektoralController@index');
  Route::get('index', 'StatistikSektoralController@index');
  Route::post('set_dss_global_year', 'StatistikSektoralController@setDssGlobalYear');

  if(strpos(Request::segment(2),"dss_") !== false){
    Route::group(['prefix' => Request::segment(2)], function () {
      $dss_controller = 'Dss\\'.ucfirst(Request::segment(2)).'_Controller';
      // Route::get('/', $dss_controller.'@view');
      Route::get('/', function () {
        $dss_controller = 'Dss\\'.ucfirst(Request::segment(2)).'_Controller';
        if(class_exists(ucfirst(Request::segment(2)).'_Controller')){
          echo 'test';
        }
      });
      Route::get('view', $dss_controller.'@view');
      Route::post('get_data', $dss_controller.'@getData');
      Route::middleware(['CheckPrivilege'])->group(function () {
        $dss_controller = 'Dss\\'.ucfirst(Request::segment(2)).'Controller';
        Route::post('store', $dss_controller.'@store');
        Route::post('delete', $dss_controller.'@delete');
        Route::post('set_verification', $dss_controller.'@setVerification');
        Route::post('set_publish', $dss_controller.'@setPublish');
      });
    });
  }
});
